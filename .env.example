# Which model drives the live agent (graph "inspectra"): groq (default) | gemini | scripted
# "scripted" needs no key and no network; it is what the graph "inspectra_offline" always uses.
INSPECTRA_MODEL=groq

# Groq (default). Free key: https://console.groq.com
GROQ_API_KEY=paste_your_key_here
# GROQ_MODEL=openai/gpt-oss-20b

# Gemini (optional). Free key: https://aistudio.google.com ; the free tier allows about
# 20 requests per day per model. propose_tests also calls Gemini through model_client.py
# for the live test proposal, so a Gemini key is needed for live (non-offline) runs.
GEMINI_API_KEY=paste_your_key_here
# MODEL_NAME=gemini-3.8-flash

# Optional: file approved issues on GitHub instead of locally (evidence/issues/filed/).
# Use a fine-grained personal access token limited to "Issues: write" on a dedicated
# demo repository only. Leave both empty to file locally.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo

# Key that signs the single-use approval tokens the file_issue and save_test_to_suite tools check
# (agent and MCP server). If empty, a built-in development default is used (removed in the
# sandbox-hardening step); set your own for any shared deployment.
APPROVAL_SECRET_KEY=

# Optional: LangSmith tracing (traces appear at smith.langchain.com).
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=inspectra

# Which project to check (optional; defaults are the bundled sample). Set by the operator only:
# the model cannot see or change these. Relative paths resolve against this repository.
# INSPECTRA_REQUIREMENTS_DIR  folder of .md files with "## Section X.Y: Title" headings
# INSPECTRA_CODE_DIR          folder holding the importable package(s) under test; approved
#                             tests are saved to its tests/ folder (not this repo's root)
# INSPECTRA_CODE_MODULES      optional comma-separated .py files (relative to the code folder)
#                             shown to the test writer; default is every non-test .py file
# Check a setup with:  venv\Scripts\python.exe src\project_config.py
# INSPECTRA_REQUIREMENTS_DIR=docs/requirements
# INSPECTRA_CODE_DIR=sut
